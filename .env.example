# ============================================================
# Divya Vaani AI - Environment Configuration
# ============================================================

# ============ LLM Configuration (Groq) ============
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ============ Gemini API (Summaries + Corrections) ============
# Get your free API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Model
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000


# ============ Security ============
# Admin API key - protects upload/admin endpoints from public abuse
# Generate a random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# CORS origins - comma-separated list of allowed origins
# Use * for development, restrict for production
CORS_ORIGINS=*

# Rate limits (format: "N/period" - e.g. "20/minute", "5/hour")
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_TTS=30/minute
RATE_LIMIT_UPLOAD=5/hour


# ============ TTS Mode ============
# "fast" (Edge TTS - default), "gtts" (Google TTS)
# Custom person-specific TTS model support coming in next version
TTS_MODE=fast


# ============ Server ============
HOST=0.0.0.0
PORT=8000
DEBUG=false


# ============ Database ============
# PostgreSQL (production): postgres://user:password@host:5432/dbname
# Leave empty for SQLite fallback (development)
DATABASE_URL=


# ============ JWT Authentication ============
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
# If empty, auto-generated on startup (tokens won't survive restarts)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
