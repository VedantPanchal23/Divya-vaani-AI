# ============================================================
# Divya Vaani AI - Environment Configuration
# ============================================================

# ============ LLM Configuration (Groq) ============
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000


# ============ Voice Cloning (XTTS-v2) ============
# Enable voice cloning to generate audio in the speaker's voice
# When enabled, all TTS (summary, explanation, Q&A) will use cloned voice
USE_VOICE_CLONING=false

# Reference audio for voice cloning
# IMPORTANT: Uses ONLY maharaj_audio.mp3 (cleanest audio, minimal background noise)
# The file should be in: Input/maharaj_audio.mp3
# This file is for voice cloning reference only - NOT for transcription
REFERENCE_AUDIO_PATH=

# TTS Mode: "fast" (Edge TTS), "clone" (voice cloning), "gtts" (Google TTS)
TTS_MODE=fast


# ============ Server ============
HOST=0.0.0.0
PORT=8000
DEBUG=false
