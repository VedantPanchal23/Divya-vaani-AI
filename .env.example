# ============================================================
# Divya Vaani AI - Environment Configuration
# ============================================================

# ============ LLM Configuration (Groq) ============
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000


# ============ Voice Cloning ============
# Voice samples are auto-detected from Input/ folder
# Set this only if you want to use a specific file:
VOICE_SAMPLE_PATH=

# Enable/disable voice cloning (set to false to use Edge TTS)
USE_VOICE_CLONING=true


# ============ Server ============
HOST=0.0.0.0
PORT=8000
DEBUG=false
