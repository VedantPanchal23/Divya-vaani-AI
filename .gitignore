# ============================
# Divya Vaani — .gitignore
# ============================

# ---------- Dependencies ----------
node_modules/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
venv/
.venv/

# ---------- Environment ----------
.env
.env.*
!.env.example

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Build artifacts ----------
.next/
out/
*.tsbuildinfo

# ---------- Backup files ----------
*.bak
*.orig
*.tmp

# ---------- Media files ----------
*.mp3
*.wav
*.m4a
*.ogg
*.webm
*.mp4
*.flac
*.aac

# ---------- Backend data ----------
# Uploads (user-uploaded files)
backend/data/uploads/*
!backend/data/uploads/.gitkeep

# Transcripts (generated per video)
backend/data/transcripts/*
!backend/data/transcripts/.gitkeep

# Audio output
backend/data/audio/*
!backend/data/audio/.gitkeep

# Thumbnails
backend/data/thumbnails/*
!backend/data/thumbnails/.gitkeep

# FAISS index (rebuilt from transcripts)
backend/data/index/

# Old ChromaDB
backend/data/chroma_db/

# ---------- Kaggle ----------
kaggle_upload/
*.ipynb_checkpoints/

# ---------- Misc ----------
input/
